#!/usr/bin/env bash
#
# asb — agent sandbox
#
# Run a coding agent inside a disposable, hardened Docker container whose only
# writable window onto the host is a bind-mounted home directory. The container
# user is created with your uid/gid so files land on the host owned by you.
#
# Usage:  asb <command> [options]
# Run    `asb help`  for the full list.

set -euo pipefail

# --------------------------------------------------------------------------
# Locate the project directory (where the Dockerfile / asb.conf live).
# --------------------------------------------------------------------------
ASB_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

# --------------------------------------------------------------------------
# Config: built-in defaults are applied last via the :=  idiom, so anything
# already set in the environment or in asb.conf wins. Precedence works out to:
#
#     command-line flags  >  environment (ASB_*)  >  asb.conf  >  defaults
#
# asb.conf is sourced *after* the env is read and uses the same `${VAR:=...}`
# idiom, so it only fills values the environment did not already set.
# --------------------------------------------------------------------------
CONF_FILE="${ASB_CONF:-$ASB_DIR/asb.conf}"
if [ -f "$CONF_FILE" ]; then
  # shellcheck disable=SC1090
  . "$CONF_FILE"
fi

: "${ASB_IMAGE:=asb}"                                  # image tag
: "${ASB_NAME:=asb-$(basename "$ASB_DIR")}"            # container name
: "${ASB_USER:=agent}"                                 # in-container username
: "${ASB_UID:=$(id -u)}"                               # -> owns files on host
: "${ASB_GID:=$(id -g)}"
: "${ASB_HOME:=$ASB_DIR/home}"                         # host dir -> container HOME
: "${ASB_WORKSPACE:=}"                                 # optional 2nd mount (host path)
: "${ASB_WORKSPACE_TARGET:=/home/$ASB_USER/workspace}" # ...its mount point
: "${ASB_PORTS:=}"                                     # comma list, e.g. 5173-5177,9323
: "${ASB_CPUS:=4}"
: "${ASB_MEMORY:=16g}"
: "${ASB_PIDS_LIMIT:=2048}"
: "${ASB_NETWORK:=bridge}"                             # bridge | none | <name>
: "${ASB_READONLY:=0}"                                 # 1 = read-only rootfs
: "${ASB_TMPFS_EXEC:=0}"                               # 1 = allow exec on /tmp
: "${ASB_SHELL:=/bin/bash}"
: "${ASB_EXTRA_RUN_ARGS:=}"                            # raw extra args to docker run

CONTAINER_HOME="/home/$ASB_USER"

# --------------------------------------------------------------------------
# Small helpers
# --------------------------------------------------------------------------
DRY_RUN=0
die()  { printf 'asb: %s\n' "$*" >&2; exit 1; }
info() { printf 'asb: %s\n' "$*" >&2; }

# Print (dry-run) or execute a command, quoting each arg for copy/paste safety.
run() {
  if [ "$DRY_RUN" -eq 1 ]; then
    printf '+ '; printf '%q ' "$@"; printf '\n'
  else
    "$@"
  fi
}

need_docker() {
  [ "$DRY_RUN" -eq 1 ] && return 0   # dry-run just prints; docker not required
  command -v docker >/dev/null 2>&1 || die "docker not found in PATH"
}

container_running() {
  [ -n "$(docker ps -q -f "name=^${ASB_NAME}$" 2>/dev/null)" ]
}

container_exists() {
  [ -n "$(docker ps -aq -f "name=^${ASB_NAME}$" 2>/dev/null)" ]
}

# --------------------------------------------------------------------------
# Build the `docker run` argument vector (as an array) for `start`.
# --------------------------------------------------------------------------
build_run_args() {
  RUN_ARGS=(run -itd --rm --name "$ASB_NAME")

  # Resource limits
  RUN_ARGS+=(--cpus "$ASB_CPUS" --memory "$ASB_MEMORY" --pids-limit "$ASB_PIDS_LIMIT")

  # Hardening: no privilege escalation, drop all Linux capabilities.
  RUN_ARGS+=(--security-opt no-new-privileges --cap-drop ALL)

  # Run as your uid/gid regardless of what the image baked in.
  RUN_ARGS+=(--user "${ASB_UID}:${ASB_GID}")

  # Network
  RUN_ARGS+=(--network "$ASB_NETWORK")

  # /tmp as tmpfs (noexec unless explicitly allowed)
  if [ "$ASB_TMPFS_EXEC" -eq 1 ]; then
    RUN_ARGS+=(--tmpfs "/tmp:rw")
  else
    RUN_ARGS+=(--tmpfs "/tmp:rw,noexec,nosuid")
  fi

  # Read-only rootfs (opt-in); give the user a writable HOME via the bind mount.
  [ "$ASB_READONLY" -eq 1 ] && RUN_ARGS+=(--read-only)

  # Bind mounts — the only writable window onto the host.
  [ -d "$ASB_HOME" ] || die "home dir does not exist: $ASB_HOME (create it or set ASB_HOME)"
  RUN_ARGS+=(-v "${ASB_HOME}:${CONTAINER_HOME}:rw")
  if [ -n "$ASB_WORKSPACE" ]; then
    [ -d "$ASB_WORKSPACE" ] || die "workspace dir does not exist: $ASB_WORKSPACE"
    RUN_ARGS+=(-v "${ASB_WORKSPACE}:${ASB_WORKSPACE_TARGET}:rw")
  fi

  # Ports
  if [ -n "$ASB_PORTS" ]; then
    local IFS=,
    for p in $ASB_PORTS; do
      [ -n "$p" ] && RUN_ARGS+=(-p "$p")
    done
  fi

  # Ensure HOME is right when running with a numeric --user.
  RUN_ARGS+=(-e "HOME=${CONTAINER_HOME}")

  # Raw escape-hatch args (word-split intentionally).
  # shellcheck disable=SC2206
  [ -n "$ASB_EXTRA_RUN_ARGS" ] && RUN_ARGS+=($ASB_EXTRA_RUN_ARGS)

  RUN_ARGS+=("$ASB_IMAGE")
}

# --------------------------------------------------------------------------
# Commands
# --------------------------------------------------------------------------
cmd_build() {
  need_docker
  run docker build \
    --build-arg "USERNAME=${ASB_USER}" \
    --build-arg "UID=${ASB_UID}" \
    --build-arg "GID=${ASB_GID}" \
    -t "$ASB_IMAGE" "$@" "$ASB_DIR"
}

cmd_rebuild() { cmd_build --no-cache "$@"; }

cmd_start() {
  need_docker
  build_run_args
  if [ "$DRY_RUN" -eq 0 ] && container_running; then
    die "container '$ASB_NAME' already running (asb stop first, or asb sh to enter)"
  fi
  run docker "${RUN_ARGS[@]}"
  [ "$DRY_RUN" -eq 0 ] && info "started '$ASB_NAME' — enter with: asb sh"
}

cmd_stop() {
  need_docker
  run docker stop "$ASB_NAME"
}

cmd_restart() { cmd_stop "$@" || true; cmd_start "$@"; }

cmd_sh() {
  need_docker
  if [ "$DRY_RUN" -eq 0 ] && ! container_running; then
    die "container '$ASB_NAME' is not running (asb start first)"
  fi
  if [ "$#" -gt 0 ]; then
    run docker exec -it "$ASB_NAME" "$@"
  else
    run docker exec -it "$ASB_NAME" "$ASB_SHELL"
  fi
}

# One-shot: start a throwaway container, run a command, tear down.
cmd_run() {
  need_docker
  [ "$#" -gt 0 ] || die "usage: asb run <command> [args...]"
  build_run_args
  # Swap the detached flags for an interactive one-shot: drop -itd, keep --rm.
  local args=()
  for a in "${RUN_ARGS[@]}"; do
    [ "$a" = "-itd" ] && { args+=(-it); continue; }
    args+=("$a")
  done
  run docker "${args[@]}" "$@"
}

cmd_status() {
  need_docker
  run docker ps -a -f "name=^${ASB_NAME}$" \
    --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'
}

cmd_logs() {
  need_docker
  run docker logs "$@" "$ASB_NAME"
}

cmd_config() {
  cat <<EOF
ASB_DIR              $ASB_DIR
ASB_CONF             ${CONF_FILE}$([ -f "$CONF_FILE" ] || echo '  (not present)')
ASB_IMAGE            $ASB_IMAGE
ASB_NAME             $ASB_NAME
ASB_USER             $ASB_USER   (HOME=$CONTAINER_HOME)
ASB_UID:ASB_GID      ${ASB_UID}:${ASB_GID}
ASB_HOME             $ASB_HOME  ->  $CONTAINER_HOME
ASB_WORKSPACE        ${ASB_WORKSPACE:-(none)}${ASB_WORKSPACE:+  ->  $ASB_WORKSPACE_TARGET}
ASB_PORTS            ${ASB_PORTS:-(none)}
ASB_CPUS             $ASB_CPUS
ASB_MEMORY           $ASB_MEMORY
ASB_PIDS_LIMIT       $ASB_PIDS_LIMIT
ASB_NETWORK          $ASB_NETWORK
ASB_READONLY         $ASB_READONLY
ASB_TMPFS_EXEC       $ASB_TMPFS_EXEC
ASB_EXTRA_RUN_ARGS   ${ASB_EXTRA_RUN_ARGS:-(none)}
EOF
}

cmd_help() {
  cat <<'EOF'
asb — agent sandbox

Usage: asb <command> [options]

Commands:
  build [docker args]    Build the image (passes your uid/gid as build args)
  rebuild [docker args]  Build with --no-cache
  start                  Launch the container (detached, --rm)
  stop                   Stop the container
  restart                Stop then start
  sh [cmd...]            Exec into the running container (default: a shell)
  run <cmd...>           One-shot: start throwaway container, run cmd, remove
  status                 Show container state
  logs [docker args]     Tail container logs
  config                 Print the resolved configuration
  help                   This help

Global options:
  --dry-run, -n          Print the docker command instead of running it
  --name <n>             Override container name  (ASB_NAME)
  --image <t>            Override image tag        (ASB_IMAGE)

Configuration (precedence: flags > env > asb.conf > defaults):
  Set ASB_* variables in the environment or in ./asb.conf.
  Run `asb config` to see the effective values. See asb.conf.example.
EOF
}

# --------------------------------------------------------------------------
# Argument parsing: pull global flags out, leave the rest for the subcommand.
# --------------------------------------------------------------------------
[ "$#" -ge 1 ] || { cmd_help; exit 1; }

SUBCMD="$1"; shift
REST=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    -n|--dry-run) DRY_RUN=1 ;;
    --name)  ASB_NAME="$2"; shift ;;
    --image) ASB_IMAGE="$2"; shift ;;
    --) shift; while [ "$#" -gt 0 ]; do REST+=("$1"); shift; done; break ;;
    *) REST+=("$1") ;;
  esac
  shift
done

case "$SUBCMD" in
  build)         cmd_build   "${REST[@]}" ;;
  rebuild)       cmd_rebuild "${REST[@]}" ;;
  start|up)      cmd_start   "${REST[@]}" ;;
  stop|down)     cmd_stop    "${REST[@]}" ;;
  restart)       cmd_restart "${REST[@]}" ;;
  sh|shell|exec) cmd_sh      "${REST[@]}" ;;
  run)           cmd_run     "${REST[@]}" ;;
  status|ps)     cmd_status  "${REST[@]}" ;;
  logs)          cmd_logs    "${REST[@]}" ;;
  config)        cmd_config ;;
  help|-h|--help) cmd_help ;;
  *) die "unknown command '$SUBCMD' (try: asb help)" ;;
esac
