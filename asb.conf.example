# asb configuration — copy to `asb.conf` and edit.
#
# This file is sourced by the `asb` script. Values use the `${VAR:=...}` idiom
# so anything already set in your environment takes precedence over the file.
# Precedence overall:  command-line flags  >  environment  >  this file  >  defaults.
#
# Show the effective config any time with:  asb config

# --- Identity ------------------------------------------------------------
# The in-container user, and the uid/gid it runs as. UID/GID default to your
# own (id -u / id -g) so files on the bind mount are owned by you on the host.
: "${ASB_USER:=agent}"
# : "${ASB_UID:=1000}"
# : "${ASB_GID:=1000}"

# --- Image / container names --------------------------------------------
: "${ASB_IMAGE:=asb}"
# : "${ASB_NAME:=asb-myproject}"   # default: asb-<dirname>

# --- Mounts (the only writable window onto the host) --------------------
# Host directory mounted as the container's HOME.
# : "${ASB_HOME:=/path/to/host/home}"       # default: <asb dir>/home
# Optional second mount for a separate workspace/code area.
# : "${ASB_WORKSPACE:=/path/to/code}"
# : "${ASB_WORKSPACE_TARGET:=/home/agent/workspace}"

# --- Networking / ports --------------------------------------------------
# Published ports, comma-separated (ranges ok). Empty = publish nothing.
# A bare port/range is published on the *same* host port (9323 -> 9323:9323);
# write host:container explicitly to remap (e.g. 8080:80, 127.0.0.1:9323:9323).
# : "${ASB_PORTS:=5173-5177,9323}"
# Network mode: bridge (default) | none (no network) | <custom network name>.
# : "${ASB_NETWORK:=bridge}"

# --- Resource limits -----------------------------------------------------
: "${ASB_CPUS:=4}"
: "${ASB_MEMORY:=16g}"
: "${ASB_PIDS_LIMIT:=2048}"

# --- Hardening toggles ---------------------------------------------------
# Read-only root filesystem (HOME stays writable via the bind mount). Some
# tooling that writes outside HOME may need this off, or extra tmpfs mounts.
# : "${ASB_READONLY:=1}"
# Allow executables on /tmp (default off: /tmp is mounted noexec,nosuid).
# : "${ASB_TMPFS_EXEC:=1}"

# --- Escape hatch --------------------------------------------------------
# Raw extra args appended to `docker run` (word-split). Use sparingly.
# : "${ASB_EXTRA_RUN_ARGS:=--add-host host.docker.internal:host-gateway}"
